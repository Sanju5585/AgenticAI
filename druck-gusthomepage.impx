$contentCatalog=bhgeContentCatalog
$contentCatalogName=bhgeContentCatalog
$productCatalogName=bhgeGlobalProductCatalog
$contentCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$contentCatalog]),CatalogVersion.version[default=Online])[default=$contentCatalog:Online]
$productCV=catalogVersion(CatalogVersion.catalog(Catalog.id[default=$productCatalogName]),CatalogVersion.version[default=Online])[default=$productCatalogName:Online]

$druckFeaturedProducts=DEW.IQ,PM880,XMTC
$druckBestSellerProducts=UTXDR,MOISTURE.IQ
$druckBanner1title=Welcome to Druck!
$druckBanner1content=Experts in pressure sensors and test and calibration instrumentation since 1972.<br>We provide peace of mind in the toughest environments
$druckBanner2title=Test and Calibration instrumentation
$druckBanner2content=Portable and Handheld Calibration Tools.<br>Portable Calibrators, Pressure Pumps, Indicators and Calibrators, Temperature and Electrical Calibrators, Pressure Controllers
$druckBanner3title=Pressure Sensors
$druckBanner3content=Configurable pressure sensors for a wide range of applications and industries.<br>Configurable modular, analogue and digital communication pressure sensors
$druckNewArrival1title=PACE Tallis
$druckNewArrival1content=Druck's new transfer standard calibrator, designed for test bench, bench top and panel mount calibration, test and monitoring applications
$druckNewArrival2title=PV624
$druckNewArrival2content=Druck’s PV624, a portable hybrid pressure controller, combining manual and automatic technologies, up to 20 bar (300 psi)

$reuterbanner1title=Welcome to Reuter Stokes!
$reuterbanner1content=For more than 60 years, Reuter-Stokes researchers and engineers have collaborated with customers to design, produce, and install reliable equipment for harsh environments
$reuterbanner2title=Downhole Sensors
$reuterbanner2content=Achieve more with sensors and orientation modules built for the smallest spaces and most challenging drilling conditions
$reuterbanner3title=Flame Sensors
$reuterbanner3content=Elevate safety, uptime, and operational efficiency with harsh environment flame sensing solutions from a trusted partner
$reuterbanner4title=Nuclear Instrumentation
$reuterbanner4content=We are a leader in neutron flux and gamma flux detectors with proven reliability in the harshest environments
$reuterbanner5title=Radiation Measurement and Monitoring
$reuterbanner5content=For years, the global neutron scattering research community has relied on Reuter-Stokes for bespoke spectroscopic detectors and data acquisition electronics that deliver the highest levels of precision
$reuterNewArrival1title=Reuter-Stokes Knowledge Zone
$reuterNewArrival1content=Welcome to the Reuter-Stokes Knowledge Zone, your source of information to expand your knowledge of mission-critical harsh environment measuring products and services for precise radiation measurement, pressurized and boiling water reactor monitoring, UV flame detection, and downhole sensing for directional drilling
$reuterNewArrival2title=Reuter-Stokes Product Repair Form
$reuterNewArrival2content=Fill out this form when requesting return authorization for products to be calibrated, repaired and/or replaced


